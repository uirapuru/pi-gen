#!/bin/bash

# OpenTAKServer Stage Configuration
# This file allows you to customize the OpenTAKServer installation

# Set to 1 to enable the stage, 0 to skip it
STAGE_OTS_ENABLED=1

# OpenTAKServer version (default: latest from PyPI)
# OTS_VERSION="latest"

# PostgreSQL database name
OTS_DB_NAME="ots"

# PostgreSQL user name
OTS_DB_USER="ots"

# Enable optional components (set to 1 to enable)
INSTALL_MEDIAMTX=1          # Media streaming server
INSTALL_ZEROTIER=0          # ZeroTier VPN (requires interactive configuration)
INSTALL_MUMBLE=1            # Mumble voice server

# nginx configuration
# Set to 1 to auto-generate self-signed certificates
AUTO_GENERATE_CERTS=1

# RabbitMQ configuration
RABBITMQ_VHOST="ots"
RABBITMQ_USER="ots"

# Logging configuration
OTS_LOG_LEVEL="INFO"
OTS_LOG_DIR="/home/\${FIRST_USER_NAME}/ots/logs"

# Additional Python packages to install (space-separated)
# EXTRA_PACKAGES=""

# Custom pip index (leave empty for default PyPI)
# PIP_INDEX_URL=""

